# Copy this file to .env (same folder) and fill in real values. .env is gitignored.
DB_URL=jdbc:postgresql://localhost:5432/ajapartelle
DB_USERNAME=ajapartelle
DB_PASSWORD=change-me

# At least 32 characters, random. Example generator (PowerShell):
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRATION_MINUTES=480
COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:5173

# Password reset emails (Gmail SMTP). MAIL_PASSWORD is a 16-character Google app password,
# not your Gmail password (needs 2-Step Verification: https://myaccount.google.com/apppasswords).
MAIL_USERNAME=your-address@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_FROM=your-address@gmail.com
# Base URL of the web app, used for the link in the email
APP_FRONTEND_URL=http://localhost:5173

# First OWNER account, created (with a bcrypt-hashed password) on first startup.
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=ChangeMe123!
OWNER_FULL_NAME=AJ Apartelle Owner
OWNER_MOBILE=09171234567
